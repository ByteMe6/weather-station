; Copy to secrets.ini (gitignored) and fill in before flashing. These are
; fleet-wide: every device gets the same values, so one firmware image serves
; all of them. Per-device identity is NOT here any more - it is provisioned
; into NVS, see "Provisioning identity" in README.md.
[secrets]
build_flags =
    ; The /v1/ segment is a pinned major API version. This build flag is only
    ; the fallback — once set, the URL in NVS wins (see "Changing the endpoint"
    ; in README.md). The fallback is fleet-wide now, but the NVS value stays
    ; per-device and there is no fleet-wide URL push, so the version changes
    ; only when migrating devices to a new contract — one at a time, by
    ; reflashing or through each device's setup portal. Backwards-compatible
    ; server changes never move it.
    -DAPI_URL=\"https://your-app.vercel.app/api/v1/readings\"
    -DOTA_BASE_URL=\"https://your-project.supabase.co/storage/v1/object/public/firmware\"