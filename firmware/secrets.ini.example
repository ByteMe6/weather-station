; Copy to secrets.ini (gitignored) and fill in per-device values before
; flashing. DEVICE_ID is printed on the device label; DEVICE_SECRET never
; leaves the device and must never land in git.
[secrets]
build_flags =
    -DDEVICE_ID=\"changeme\"
    -DDEVICE_SECRET=\"changeme\"
    -DSEND_INTERVAL_MS=300000
    -DAPI_URL=\"https://your-app.vercel.app/api/v1/readings\"
    -DOTA_BASE_URL=\"https://your-project.supabase.co/storage/v1/object/public/firmware\"
