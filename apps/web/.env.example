# Secrets are managed with Infisical. Inject them at runtime with
#   infisical run -- <command>        e.g. infisical run -- yarn workspace @ws/web dev
# (the `test:integration:secrets` script already wraps the integration test this way).
# A local .env.local (gitignored) still works as a fallback — copy this file and
# fill values from the Clerk/Supabase dashboards (ask the team for dev keys).

# Clerk — web auth (PRD W1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — browser client (publishable key, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (service role, bypasses RLS — never NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# API docs (OpenAPI + Scalar UI) — auto-off in production. Set to force on/off.
API_DOCS_ENABLED=
