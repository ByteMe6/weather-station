# Secrets are managed with Infisical. Inject them at runtime with
#   infisical run -- <command>        e.g. infisical run -- yarn workspace @ws/web dev
# (the `test:integration:secrets` script already wraps the integration test this way).
# A local .env.local (gitignored) still works as a fallback — copy this file and
# fill values from the Clerk/Supabase dashboards (ask the team for dev keys).

# Clerk — web auth (PRD W1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — browser client (publishable key, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (service role, bypasses RLS — never NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# API docs (OpenAPI + Scalar UI) — on by default everywhere (the public API needs them).
# Set to `false` to turn /reference and openapi.json off.
API_DOCS_ENABLED=

# Clerk routing is set in code (src/proxy.ts + RootProviders): /sign-in, /sign-up, → /dashboard.
# Clerk dashboard (not code): enable Email + Google; Sessions → Customize session token → add {"role":"authenticated"}
# (required for Supabase third-party auth — without it every RLS query returns empty).

# Telegram bot username from BotFather — used for the account-linking deep link.
# A leading @ or a full t.me URL is stripped, then the result is validated; an
# unusable value fails at "Link Telegram" rather than producing a dead link.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Clerk webhook (user.deleted → erase rows). Endpoint: /api/webhooks/clerk. From Clerk dashboard → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk organization whose members may use /admin. Must equal the Supabase
# Vault secret `admin_org_id` (set with `yarn admin:set-org` from
# infra/supabase-db) — the app compares the two and warns if they differ.
ADMIN_ORG_ID=

# Address the Playwright suite signs in as. Clerk Testing Tokens mint a
# server-side session from the address alone — no password is involved.
# Requires a Clerk DEVELOPMENT instance.
E2E_CLERK_USER_EMAIL=
