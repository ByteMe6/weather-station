# Copy to .env.local (gitignored). Values come from the Clerk and Supabase
# dashboards — ask the team for the dev-instance keys.

# Clerk — web auth (PRD W1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — browser client (publishable key, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (service role, bypasses RLS — never NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
