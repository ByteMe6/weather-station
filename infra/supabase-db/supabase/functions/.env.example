# Local dev secrets for `supabase functions serve` — copy to .env (gitignored).
# In production, set these with: npx supabase secrets set KEY=value

# Telegram bot token from @BotFather
BOT_TOKEN=

# Random secret passed to Telegram's setWebhook; grammY rejects updates
# that do not carry it (defense against forged webhook calls)
BOT_WEBHOOK_SECRET=

# Service-role access for the bot's own DB writes (account linking, /register).
# Local values come from `npx supabase status`; these two are for
# `functions serve` only. Do NOT try to `npx supabase secrets set` them - the
# `SUPABASE_` prefix is reserved and the CLI rejects it. In production both are
# injected automatically (the key as SUPABASE_SERVICE_ROLE_KEY, which
# _shared/db.ts falls back to).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Shared secret required in x-cron-secret by alert-dispatcher; must equal the
# Vault value written by `yarn cron:set-secret <url> <secret>`.
CRON_SECRET=
