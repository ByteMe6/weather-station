{
  "name": "@ws/supabase-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "jest --selectProjects=unit --ci --runInBand --passWithNoTests",
    "test:db": "npx supabase test db",
    "db-reset:local": "npx supabase db reset",
    "migrate:new": "npx supabase migration new",
    "migrate:up": "npx supabase db push --local",
    "regenerate:types": "npx supabase gen types typescript --local > src/types/database.ts",
    "deploy:functions": "npx supabase functions deploy telegram-bot",
    "admin:set-org": "node --env-file-if-exists=.env --experimental-strip-types scripts/set-admin-org.ts",
    "provision:device": "node --env-file-if-exists=.env --experimental-strip-types scripts/provision-device.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@ws/shared": "workspace:*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@ws/eslint-config": "workspace:*",
    "@ws/tsconfig": "workspace:*",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "supabase": "^2.22.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  }
}
